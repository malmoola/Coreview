{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiveTopo",
  "version": "0.1.0",
  "identifier": "net.livetopo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LiveTopo",
        "width": 1600,
        "height": 1000,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      },
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    },
    "shortDescription": "Local-first network diagram designer with live validation",
    "longDescription": "LiveTopo lets network engineers draw their real topology and continuously validate configured reachable targets during maintenance windows. All data stays on the local machine.",
    "linux": {
      "deb": {
        "depends": [
          "iputils-ping"
        ]
      }
    },
    "category": "Utility"
  }
}
